# Ghostty configuration
# See: https://ghostty.org/docs/config

# Font (matches alacritty/wezterm)
font-family = "Hack Nerd Font Mono"
font-style = "Bold"
font-size = 16

# Window
background-opacity = 1
window-padding-x = 2
window-padding-y = 2

# Scrollback
scrollback-limit = 10000000

# Copy selection to clipboard on select (matches alacritty)
copy-on-select = clipboard

# Melange color scheme (official colors from melange-nvim)
# Warm, dark colorscheme with vintage feel
# See: https://github.com/savq/melange-nvim
#
# A built-in equivalent is available via `theme = "Melange Dark"`, but these
# explicit values match the rest of the dotfiles (alacritty, wezterm, tmux,
# zellij, btop, lsd) exactly.
background = 292522
foreground = ECE1D7
cursor-color = ECE1D7
cursor-text = 292522
selection-background = 403A36
selection-foreground = ECE1D7

# ANSI colors (0-7): Melange official palette
palette = 0=#34302C
palette = 1=#BD8183
palette = 2=#78997A
palette = 3=#E49B5D
palette = 4=#7F91B2
palette = 5=#B380B0
palette = 6=#7B9695
palette = 7=#C1A78E

# Bright colors (8-15): Melange official palette
palette = 8=#867462
palette = 9=#D47766
palette = 10=#85B695
palette = 11=#EBC06D
palette = 12=#A3A9CE
palette = 13=#CF9BC2
palette = 14=#89B3B6
palette = 15=#ECE1D7
